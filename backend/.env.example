PORT=4000
# Wajib diganti dengan string acak yang aman (contoh buat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=ganti-dengan-string-acak-yang-aman
# Daftar origin frontend yang diizinkan CORS (pisahkan koma). Kosongkan untuk same-origin saja.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set true HANYA jika berjalan di belakang reverse proxy tepercaya (nginx, Cloudflare, dsb.)
TRUST_PROXY=false
# Opsional: dipakai `npm run seed` untuk merotasi password admin default (min. 8 karakter).
# ADMIN_PASSWORD=
# Opsional: kredensial akun khusus bot WhatsApp yang dibuat `npm run seed` (min. 8 karakter).
# BOT_USERNAME=bot
# BOT_PASSWORD=
# Opsional (SANGAT DISARANKAN): aktifkan HTTPS agar password & token tidak
# lewat jaringan tanpa enkripsi. Isi dengan path file PEM.
# Buat sertifikat self-signed untuk LAN:
#   openssl req -x509 -newkey rsa:2048 -nodes -keyout backend/certs/key.pem \
#     -out backend/certs/cert.pem -days 825 -subj "/CN=rentalku.local"
# HTTPS_KEY=./certs/key.pem
# HTTPS_CERT=./certs/cert.pem
