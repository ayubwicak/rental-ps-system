# Konfigurasi Rental PS REST API (Express Backend)
RENTAL_API_URL=http://localhost:4000/api
# WAJIB pakai akun bot khusus (role kasir), BUKAN akun admin.
# Buat lewat `cd backend && npm run seed` lalu salin kredensial yang tercetak.
RENTAL_API_USERNAME=bot
RENTAL_API_PASSWORD=

# AI Processing Configuration (opsional, fallback parser selalu aktif jika AI tidak disetting/gagal)
AI_PROVIDER=none
AI_API_KEY=

# Informasi Admin & Handoff
ADMIN_PHONE=+6281234567890

# Mode Simulasi CLI (set true untuk menguji tanpa scan QR WhatsApp)
ENABLE_SIMULATION_MODE=false
